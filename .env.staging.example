# Plantilla de variables para el stack de staging (docker-compose.staging.yml).
# Copia este archivo a `.env.staging` (NO a `.env`: ese es el de desarrollo
# local nativo, sin Docker) y rellena los valores reales. `.env.staging`
# está en .gitignore/.dockerignore — nunca se sube al repo ni entra en
# ninguna imagen.
#
# Dos mecanismos distintos leen este mismo archivo, y conviene no
# confundirlos (ver [[CI-CD y Despliegue Staging]]):
#   - `docker compose --env-file .env.staging ...` (usado por
#     scripts/deploy-staging.sh): interpola ${VARIABLE} dentro del propio
#     docker-compose.staging.yml, incluidos los `build.args` — así llega
#     NEXT_PUBLIC_API_URL a la imagen del frontend en tiempo de build.
#   - `env_file: .env.staging` (dentro de cada servicio del compose):
#     inyecta las variables como entorno real DENTRO de cada contenedor ya
#     arrancado.

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_USER=erp
POSTGRES_PASSWORD=cambia-esta-contraseña-en-staging
POSTGRES_DB=erp_dev
# Dentro de la red de Docker el host es el nombre del servicio (`db`), no
# localhost: localhost dentro de un contenedor se refiere a sí mismo.
DATABASE_URL=postgres://erp:cambia-esta-contraseña-en-staging@db:5432/erp_dev

# ── API (NestJS) ──────────────────────────────────────────────────────────
API_PORT=3001
# Secreto HS256 de los access tokens — mínimo 32 caracteres, obligatorio.
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio-de-verdad
#JWT_ACCESS_TTL=900
#JWT_REFRESH_TTL=2592000
# CORS: origen público real desde el que se sirve el frontend — el que verá
# el navegador del usuario, NO el nombre del servicio Docker `web`.
WEB_ORIGIN=https://staging.tu-dominio.example
# Almacenamiento de originales (documentos/facturas). En staging se monta
# un volumen Docker en esta ruta (ver docker-compose.staging.yml); en
# producción real esto sería S3/R2 (pendiente, ver Roadmap y Fases).
STORAGE_DIR=/app/storage

# Copiloto NLQ y pipeline OCR/IA (opcionales: sin esta clave, ambos quedan
# desactivados con un aviso, no rompen el arranque).
ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=

# ── Web (Next.js) ─────────────────────────────────────────────────────────
# URL pública de la API tal y como la ve el NAVEGADOR del usuario — se
# incrusta en el JS del cliente en el momento del build de la imagen
# (`docker compose build`), no se puede cambiar luego sin reconstruir.
# NO uses aquí el nombre interno del servicio Docker (`api`): el navegador
# está fuera de la red de Docker y no puede resolverlo.
NEXT_PUBLIC_API_URL=https://staging.tu-dominio.example:3001

# ── MCP ───────────────────────────────────────────────────────────────────
# Dentro de la red de Docker sí se usa el nombre del servicio: el MCP corre
# en el mismo host que la API, no en el navegador de nadie.
ERP_API_URL=http://api:3001
# El token es una sesión de un usuario real (JWT de /auth/login), no un
# secreto fijo: no tiene sentido guardarlo aquí. Pásalo al invocar:
#   docker compose --env-file .env.staging -f docker-compose.staging.yml \
#     run --rm -e ERP_API_TOKEN=<jwt> mcp

# ── Observabilidad (Fase 8, perfil `monitoring`) ─────────────────────────
# Contraseña del usuario admin de Grafana (usuario fijo: admin). Sin
# perfil `monitoring` en el `up` (ver docker-compose.staging.yml) esta
# variable no se usa para nada.
GRAFANA_ADMIN_PASSWORD=cambia-esta-contraseña-en-staging
