# Copia este archivo a .env y ajusta los valores

# PostgreSQL (ver infra/docker/docker-compose.yml para desarrollo local)
DATABASE_URL=postgres://erp:erp@localhost:5432/erp_dev

# Puerto de la API
API_PORT=3001

# Clave de firma de las sesiones (JWT). Mínimo 32 caracteres.
# En producción la API se niega a arrancar sin ella; en desarrollo se genera
# una temporal y las sesiones no sobreviven a un reinicio.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Usuario inicial de Dirección que crea el seed. Si no defines la contraseña
# se genera una al azar y se imprime una sola vez por consola.
#SEED_ADMIN_EMAIL=direccion@empresa.local
#SEED_ADMIN_NAME=Dirección
#SEED_ADMIN_PASSWORD=

# URL de la API vista desde el navegador (frontend)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Carpeta de originales subidos (S3/R2 en producción).
# Por defecto: <raíz del repo>/storage
#STORAGE_DIR=

# Pipeline OCR/IA: lectura automática de documentos con Claude
ANTHROPIC_API_KEY=
# Modelo de extracción (por defecto claude-opus-4-8)
#ANTHROPIC_MODEL=
# Intervalo del worker en milisegundos (por defecto 10000)
#OCR_WORKER_INTERVAL_MS=
