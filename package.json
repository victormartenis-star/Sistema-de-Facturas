{
  "name": "sistema-de-facturas",
  "private": true,
  "version": "0.1.0",
  "description": "ERP de gestión integral para empresas de construcción",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:packages": "npm run build -w @erp/shared -w @erp/db",
    "build": "npm run build:packages && npm run build -w @erp/api && npm run build -w @erp/web",
    "db:generate": "npm run generate -w @erp/db",
    "db:migrate": "npm run migrate -w @erp/db",
    "db:seed": "npm run seed -w @erp/db",
    "dev:api": "npm run dev -w @erp/api",
    "dev:web": "npm run dev -w @erp/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test -w @erp/shared",
    "test:integration": "npm run test:integration -w @erp/api",
    "test:coverage": "npm run test:coverage -w @erp/shared && npm run test:integration:coverage -w @erp/api && node scripts/merge-coverage.mjs",
    "verify": "npm run build:packages && npm run typecheck && npm run lint && npm run format:check && npm run test && npm run test:integration",
    "e2e": "npm run test -w @erp/e2e",
    "seed:e2e": "npm run seed:e2e -w @erp/e2e",
    "e2e:ui": "npm run test:ui -w @erp/e2e",
    "e2e:report": "npm run test:report -w @erp/e2e",
    "staging:up": "bash scripts/deploy-staging.sh",
    "staging:down": "docker compose --env-file .env.staging -f docker-compose.staging.yml down",
    "staging:logs": "docker compose --env-file .env.staging -f docker-compose.staging.yml logs -f"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^17.11.0",
    "nyc": "^18.0.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.68.0"
  }
}
