{
  "name": "sistema-de-facturas",
  "private": true,
  "version": "0.1.0",
  "description": "ERP de gestión integral para empresas de construcción",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:packages": "npm run build -w @erp/shared -w @erp/db",
    "build": "npm run build:packages && npm run build -w @erp/api && npm run build -w @erp/web",
    "db:generate": "npm run generate -w @erp/db",
    "db:migrate": "npm run migrate -w @erp/db",
    "db:seed": "npm run seed -w @erp/db",
    "dev:api": "npm run dev -w @erp/api",
    "dev:web": "npm run dev -w @erp/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "verify": "npm run build:packages && npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.68.0"
  }
}
